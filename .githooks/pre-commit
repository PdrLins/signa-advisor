#!/bin/sh
# Bump the version of each app that this commit changes (patch number):
#   back-end/  -> back-end/VERSION                       (shown by GET /api/v1/version)
#   front-end/ -> front-end/package.json (+ package-lock.json)  (shown in Profile → About)
# Enabled with: git config core.hooksPath .githooks
set -e
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only)

# A version file already changed in this commit was set by hand: keep it.
if echo "$staged" | grep -q '^back-end/' && ! echo "$staged" | grep -qx 'back-end/VERSION'; then
  python3 - "$root/back-end/VERSION" <<'PY'
import sys
p = sys.argv[1]
try:
    major, minor, patch = (int(x) for x in open(p).read().strip().split("."))
except Exception:
    major, minor, patch = 1, 0, -1
v = f"{major}.{minor}.{patch + 1}"
open(p, "w").write(v + "\n")
print(f"back-end version -> {v}")
PY
  git add "$root/back-end/VERSION"
fi

if echo "$staged" | grep -q '^front-end/' && ! git diff --cached -U0 -- front-end/package.json | grep -q '^[-+].*"version"'; then
  python3 - "$root/front-end" <<'PY'
import json, re, sys
d = sys.argv[1]
pkg_path = f"{d}/package.json"
text = open(pkg_path).read()
cur = json.loads(text).get("version", "1.0.0")
major, minor, patch = (int(x) for x in cur.split("."))
v = f"{major}.{minor}.{patch + 1}"
open(pkg_path, "w").write(re.sub(r'("version"\s*:\s*")[^"]+(")', rf"\g<1>{v}\g<2>", text, count=1))
lock_path = f"{d}/package-lock.json"
try:
    lock = json.load(open(lock_path))
    lock["version"] = v
    if "" in lock.get("packages", {}):
        lock["packages"][""]["version"] = v
    open(lock_path, "w").write(json.dumps(lock, indent=2) + "\n")
except FileNotFoundError:
    pass
print(f"front-end version -> {v}")
PY
  git add "$root/front-end/package.json"
  [ -f "$root/front-end/package-lock.json" ] && git add "$root/front-end/package-lock.json"
fi
exit 0
