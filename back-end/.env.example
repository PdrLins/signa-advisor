# Anthropic Claude API
# Claude: CLAUDE_LOCAL=true uses only the `claude` CLI on this machine (your
# subscription) and never the API. Set false to use only the paid API (then
# ANTHROPIC_API_KEY is required).
CLAUDE_LOCAL=true
ANTHROPIC_API_KEY=sk-ant-xxxxx

# xAI Grok API
XAI_API_KEY=xai-xxxxx
GROK_MODEL=grok-2-latest

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=123456789
# Login second factor. true = password + Telegram code (default).
# false = password only — keep the app on 127.0.0.1 if you turn this off.
LOGIN_OTP_ENABLED=true
# Brain Editor unlock code by Telegram. false (or Telegram not configured)
# = no message is sent and BRAIN_OTP_FALLBACK_CODE unlocks instead.
BRAIN_OTP_ENABLED=true
BRAIN_OTP_FALLBACK_CODE=123456

# Supabase — SUPABASE_KEY MUST be the service_role key (server-side only,
# never ship it to the front-end). Every table has RLS on (app/db/schema.sql),
# so the anon key can't read anything; the backend warns at startup if it sees one.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJxxxxx

# AI providers: Claude = analysis, Grok = news/sentiment. (Gemini was
# removed; old GEMINI_* keys and a "gemini" entry below are ignored.)
SYNTHESIS_PROVIDERS=["claude"]
SENTIMENT_PROVIDERS=["grok"]

# AI budget (~$50/month). Daily caps ≈ monthly / 21 trading days.
BUDGET_GROK_MONTHLY_USD=45
BUDGET_GROK_DAILY_USD=2.15
# Claude budget only matters when CLAUDE_LOCAL=false
BUDGET_CLAUDE_MONTHLY_USD=5
BUDGET_CLAUDE_DAILY_USD=0.25
# Holdings monitor: Grok red-flag search at most once per stock per N days
# (a cached scan/check result is reused for free). ETFs/crypto never.
HOLDINGS_GROK_REFRESH_DAYS=7

# Codex (OpenAI) — independent second opinion on decision-model BUYs.
# CODEX_LOCAL=true uses the local `codex` CLI (run `codex login` once;
# ChatGPT plan, $0). false = the OpenAI API with OPENAI_API_KEY; then
# CODEX_MODEL is REQUIRED (empty = Codex unavailable on the API path).
# CODEX_DECISION_MODE: record (store the verdict only) | veto (a Codex
# AVOID/SELL with confidence >= 60 turns the BUY into HOLD) | off.
CODEX_ENABLED=true
CODEX_LOCAL=true
OPENAI_API_KEY=
CODEX_MODEL=
CODEX_DECISION_MODE=record
CODEX_TIMEOUT_S=120
# API path only; 0 = unset -> capped at $5/month anyway.
BUDGET_OPENAI_MONTHLY_USD=0

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=xxxxx

# Auth (always enforced — there is no AUTH_ENABLED switch)
# JWT_SECRET_KEY and BRAIN_TOKEN_SECRET are REQUIRED, must be >= 32 chars,
# must differ from each other, and the placeholder below is rejected at
# startup. Generate each with:  openssl rand -hex 32
DEBUG=false
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_GRACE_HOURS=4
JWT_MAX_SESSION_HOURS=24
OTP_EXPIRE_SECONDS=120
SESSION_TOKEN_EXPIRE_SECONDS=180

# Brain Editor (separate secret for brain tokens — must differ from JWT_SECRET_KEY)
BRAIN_TOKEN_SECRET=generate-with-openssl-rand-hex-32

# CORS (JSON array of allowed origins). Add your Tailscale/LAN origin if used,
# e.g. ["http://localhost:3000","http://127.0.0.1:3000","https://mac.tailnet.ts.net"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Telegram Webhook Secret (set when registering webhook)
TELEGRAM_WEBHOOK_SECRET=
# Bot @username without the @, for the "Connect Telegram" links users open
# (t.me/<bot>?start=<code>). Optional: read once from Telegram (getMe) if empty.
TELEGRAM_BOT_USERNAME=
# Per-user Telegram notifications for Premium (migration 016). Default true.
# TELEGRAM_NOTIFICATIONS_ENABLED=true

# Dev tools: lets an owner preview the app as free/premium (web "View as" switch).
# Local development only. Never enable in production.
DEV_TOOLS_ENABLED=false

# --- Email sign-in (migration 018) ---
# console = the code is written to the back-end log (development only)
EMAIL_PROVIDER=console
EMAIL_FROM=Signa <no-reply@your-domain.com>
RESEND_API_KEY=
# EMAIL_PROVIDER=smtp works with Amazon SES, Brevo, Postmark, Gmail…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Public "Create account": keep false until Signa is hosted
SIGNUP_ENABLED=false

# --- Referrals / invite-only sign-up (migration 019) ---
# Public URL of the web app (no trailing slash). Invite links become
# <WEB_APP_URL>/signup?code=<account id>. Optional: share_url is null when empty.
WEB_APP_URL=
